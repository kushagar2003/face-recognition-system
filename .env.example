# Copy this file to .env and replace the placeholders with your Neon values.
# Never commit .env to Git.
#
# If your password has special characters (@ : / ? # % & etc.), URL-encode it.
# See the Step 2 setup guide for the PowerShell command.

DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/YOUR_DATABASE?sslmode=require
